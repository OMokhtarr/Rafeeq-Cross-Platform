<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|fontScale|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Android Auto: media browser service -->
        <service
            android:name=".auto.RafeeqMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
                <!-- Newer Android Auto hosts enumerate the launcher grid by this
                     category alone; the bare action above is only enough to bind
                     the service, which is why playback worked while the icon was
                     missing on devices with a recent Auto/Play Services. -->
                <category android:name="androidx.car.app.category.MEDIA" />
            </intent-filter>
        </service>

        <!-- Android Auto: declares this app as a media app -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <receiver
            android:name=".prayer.PrayerAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".prayer.PrayerBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <!-- Granting exact alarms re-arms at once, upgrading the
                     pending inexact alarm to an exact one. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The widget's appearance settings. Opened by the launcher on
             placement (ACTION_APPWIDGET_CONFIGURE) and again from the prayer
             times page. Exported because the launcher starts it; it takes no
             input but a widget id, and writes only that widget's own colours. -->
        <activity
            android:name=".prayer.PrayerWidgetConfigActivity"
            android:launchMode="singleTop"
            android:theme="@style/WidgetConfigTheme.Night"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget: reads PrayerTimesEngine directly, never a
             cache written by the app, since the launcher process has no
             WebView and the widget must be right even if the app was never
             opened. updatePeriodMillis is 0 in widget_prayer_times_info.xml;
             the prayer alarms and the midnight roll drive refreshes instead. -->
        <!-- Exported so the system can reach it. An app-widget receiver that
             is not exported never appears in the launcher's widget picker —
             the widget could then only be added from inside the app, via the
             pin request. The filter below is the only surface: APPWIDGET_UPDATE
             is the system's own, and the two step actions carry nothing but a
             widget id and a delta. -->
        <receiver
            android:name=".prayer.PrayerWidgetProvider"
            android:label="@string/prayer_widget_label_strip"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />

                <!-- The arrows and the revert timer. A manifest-declared
                     receiver is only woken for actions it declares, so
                     without these two the PendingIntents reached the
                     provider only while some other component already had the
                     process alive — which is why the arrows appeared to work
                     with the app open and do nothing once it was closed.
                     Both are internal to this package and the receiver is
                     not exported, so nothing else can send them. -->
                <action android:name="com.rafeeq.quranquiz.prayer.WIDGET_STEP" />
                <action android:name="com.rafeeq.quranquiz.prayer.WIDGET_REVERT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prayer_times_info" />
        </receiver>

        <!-- The two timetable widgets: every visible prayer at once, with no
             arrows to step through. Separate receivers rather than one
             resizable provider because the launcher's picker lists providers,
             so this is what gives each form its own entry and default size.

             Exported for the same reason as the strip: a widget provider the
             system cannot reach never appears in the picker. They declare
             only APPWIDGET_UPDATE — the step and revert actions belong to the
             strip alone, since a timetable has nothing to step through. -->
        <receiver
            android:name=".prayer.PrayerTimetableVerticalWidget"
            android:label="@string/prayer_widget_label_vertical"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timetable_vertical_info" />
        </receiver>

        <receiver
            android:name=".prayer.PrayerTimetableWideWidget"
            android:label="@string/prayer_widget_label_wide"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timetable_wide_info" />
        </receiver>

        <!-- Backs the widget's swipeable card deck. The launcher binds this
             directly to pull each card, which is why it must be exported and
             permission-guarded: BIND_REMOTEVIEWS is held by the system only,
             so the export surface is the launcher and nothing else. -->
        <service
            android:name=".prayer.PrayerDeckService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Recite Mode: microphone capture (getUserMedia in the WebView).
         Capacitor prompts for this at runtime the first time the mic is used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Coarse, not fine: prayer times shift about four seconds per kilometre
         of longitude, so city-level accuracy is already finer than the one
         minute the app displays — and the prompt is gentler. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- SCHEDULE_EXACT_ALARM, not USE_EXACT_ALARM: Play restricts the latter to
         apps whose core function is an alarm clock or calendar. This one is
         user-revocable (and off by default on Android 14+ fresh installs), so
         PrayerAlarmScheduler checks canScheduleExactAlarms() and falls back to
         an inexact alarm when it is not granted. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms do not survive a reboot; the boot receiver re-arms them. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
