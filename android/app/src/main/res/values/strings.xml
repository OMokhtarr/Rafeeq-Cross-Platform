    <string name="prayer_widget_desc_wide">جميع المواقيت في صف أفقي</string>

    <!-- Widget configuration screen. Arabic, matching the widget's own
         labels: the launcher shows this screen in the device locale, but the
         app is Arabic-first and the widget itself is always Arabic. -->
    <string name="widget_config_title">إعدادات الأداة</string>
    <string name="widget_config_background">لون الخلفية</string>
