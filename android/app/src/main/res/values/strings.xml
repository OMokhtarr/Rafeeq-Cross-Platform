<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">Rafeeq</string>
    <string name="title_activity_main">Rafeeq</string>
    <string name="package_name">com.rafeeq.quranquiz</string>
    <string name="custom_url_scheme">com.rafeeq.quranquiz</string>

    <!-- Prayer widget. English here, Arabic in values-ar/: the widget
         follows the device language, and any language other than Arabic
         gets English. -->
    <string name="prayer_widget_name_fajr">Fajr</string>
    <string name="prayer_widget_name_sunrise">Sunrise</string>
    <string name="prayer_widget_name_duha">Duha</string>
    <string name="prayer_widget_name_dhuhr">Dhuhr</string>
    <string name="prayer_widget_name_asr">Asr</string>
    <string name="prayer_widget_name_maghrib">Maghrib</string>
    <string name="prayer_widget_name_isha">Isha</string>
    <string name="prayer_widget_name_midnight">Midnight</string>
    <string name="prayer_widget_name_last_third">Last third</string>
    <!-- Arrow buttons: spoken by TalkBack, never drawn on screen. -->
    <string name="prayer_widget_prev">Previous time</string>
    <string name="prayer_widget_next">Next time</string>
    <string name="prayer_widget_prompt">Open the app to set your location</string>

    <!-- Names and one-line descriptions shown in the launcher's widget
         picker. Each provider needs its own pair; without a label the picker
         falls back to the app name and lists three identical entries. -->
    <string name="prayer_widget_label_strip">Prayer times</string>
    <string name="prayer_widget_desc_strip">A strip showing one time with a countdown</string>

    <string name="prayer_widget_label_vertical">Prayer times — list</string>
    <string name="prayer_widget_desc_vertical">All times in a vertical list</string>

    <string name="prayer_widget_label_wide">Prayer times — wide</string>
    <string name="prayer_widget_desc_wide">All times in one row</string>

    <!-- Widget configuration screen, in the same language as the widget. -->
    <string name="widget_config_title">Widget settings</string>
    <string name="widget_config_background">Background colour</string>
    <string name="widget_config_transparency">Transparency</string>
    <string name="widget_config_text_color">Text colour</string>
    <string name="widget_config_accent">Prayer card colour</string>
    <string name="widget_config_font_size">Font size</string>
    <string name="widget_config_save">Save</string>
    <string name="widget_config_time_format">Time format</string>
    <string name="widget_config_time_12">12-hour</string>
    <string name="widget_config_time_24">24-hour</string>
    <string name="widget_config_reset">Reset to default</string>
    <!-- Swatch that clears a colour so the widget follows the device theme. -->
    <string name="widget_config_auto">Auto</string>
    <!-- Slider read-outs. Formatted rather than concatenated so the digits
         localise with the rest of the screen. -->
    <string name="widget_config_percent">%1$d%%</string>
    <string name="widget_config_sp">%1$d</string>
    <!-- Stands in for the place name in the preview before a fix is stored. -->
    <string name="widget_config_sample_place">Your location</string>
</resources>
