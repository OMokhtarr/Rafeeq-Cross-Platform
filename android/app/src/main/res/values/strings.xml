    <string name="prayer_widget_name_midnight">م. الليل</string>
    <string name="prayer_widget_name_last_third">ث. الاخير</string>
    <!-- Arrow buttons: spoken by TalkBack, never drawn on screen. -->
    <string name="prayer_widget_prev">الوقت السابق</string>
    <string name="prayer_widget_next">الوقت التالي</string>
    <string name="prayer_widget_prompt">افتح التطبيق لتحديد الموقع</string>

