    <string name="widget_config_time_24">٢٤ ساعة</string>
    <string name="widget_config_reset">استعادة الافتراضي</string>
    <!-- Swatch that clears a colour so the widget follows the device theme. -->
    <string name="widget_config_auto">تلقائي</string>
