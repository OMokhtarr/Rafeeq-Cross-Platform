<?xml version="1.0" encoding="utf-8"?>
<!--
  3x3 portrait timetable. updatePeriodMillis is the same 30-minute
  backstop as the strip's: the alarm chain refreshes exactly when the display
  changes, and the periodic update re-arms it if a force-stop wiped it.

  Resizable both ways: unlike the strip, this form does reflow usefully — the
  rows are weighted, so a taller widget simply gives each one more room.

  configure is deliberately unset. The launcher would otherwise open the
  appearance screen the moment the widget is dropped, and a first-run colour
  picker in front of someone who just wanted the times is the wrong order.
  The screen is still reachable from the app and from a long-press.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_timetable_vertical"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_timetable_vertical_preview"
    android:description="@string/prayer_widget_desc_vertical"
    android:updatePeriodMillis="1800000" />
