<?xml version="1.0" encoding="utf-8"?>
<!--
  The transparency backdrop behind the live preview: a coarse checker built
  from stacked layers rather than a tiled bitmap, because <bitmap> cannot tile
  a vector and this avoids adding a PNG for four squares.

  Over a plain colour a transparent widget would just look like that colour,
  which is exactly what the preview must not imply — the checker reads as
  "nothing here".
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#9E9E9E" />
        </shape>
    </item>
    <item android:gravity="top|start" android:width="40dp" android:height="40dp">
        <shape android:shape="rectangle">
            <solid android:color="#6E6E6E" />
        </shape>
    </item>
    <item android:gravity="top|end" android:width="40dp" android:height="40dp">
        <shape android:shape="rectangle">
            <solid android:color="#6E6E6E" />
        </shape>
    </item>
    <item android:gravity="bottom|start" android:width="40dp" android:height="40dp">
        <shape android:shape="rectangle">
            <solid android:color="#6E6E6E" />
        </shape>
    </item>
    <item android:gravity="bottom|end" android:width="40dp" android:height="40dp">
        <shape android:shape="rectangle">
            <solid android:color="#6E6E6E" />
        </shape>
    </item>
</layer-list>
