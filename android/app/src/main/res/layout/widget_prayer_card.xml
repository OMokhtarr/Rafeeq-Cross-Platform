<?xml version="1.0" encoding="utf-8"?>
<!--
  Day variant of one prayer card: dark text on a light card. Name over time,
  and nothing else — the timer lives on the strip beside the card, not inside
  it, so the card stays the compact block the design calls for.

  Every view id here must also exist in layout-night/widget_prayer_card.xml —
  PrayerDeckFactory sets views by id and a mismatch crashes whichever
  configuration is inflated.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_card_background_light"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/card_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:textSize="14sp"
        android:maxLines="1"
        android:textAlignment="center" />

</LinearLayout>
