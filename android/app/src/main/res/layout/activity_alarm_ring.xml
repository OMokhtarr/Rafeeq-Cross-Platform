<?xml version="1.0" encoding="utf-8"?>
<!-- The prayer alarm's ringing screen. Colours are painted at runtime by
     AlarmRingActivity from the app's stored theme, so nothing here is
     coloured except what never changes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp">

        <View
            android:id="@+id/alarm_pulse"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center" />

        <FrameLayout
            android:id="@+id/alarm_logo_ring"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:padding="14dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher_round" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textSize="64sp" />

    <TextView
        android:id="@+id/alarm_lines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/alarm_stop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="32dp"
        android:text="@string/alarm_stop"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/alarm_snooze"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="32dp"
        android:textAllCaps="false"
        android:textSize="17sp" />
</LinearLayout>
