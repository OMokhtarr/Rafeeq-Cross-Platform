<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's configuration screen: opened by the launcher when the widget is
  placed, and again from the prayer times page.

  A live preview sits on top, over a checkerboard so transparency is visible
  for what it is rather than reading as "white". Below it, one labelled row per
  setting: a slider row carries its value
  at the end of the label line, and each colour is a row of swatches chosen
  in place.
-->
<!-- config_root takes the system-bar insets at runtime. The screen is drawn
     edge to edge (enforced for SDK 36 apps on Android 15+), so without them
     the preview slid up under the status bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ── Live preview ──────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_config_checkerboard"
        android:padding="16dp">

        <!-- The real widget layout, inflated and painted by the activity from
             the same values the widget itself uses — so the preview cannot
             drift from what lands on the home screen.

             Deliberately no android:id here: an id on <include> *replaces*
             the root id of the included layout, which would delete
             widget_root from this hierarchy and make the activity's
             findViewById(R.id.widget_root) return null. The activity reaches
             the preview through widget_root itself. -->
        <include layout="@layout/widget_prayer_times" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <!-- ── Background colour ───────────────────────────── -->
            <TextView
                style="@style/WidgetConfigSectionLabel"
                android:text="@string/widget_config_background" />

            <!-- Filled with swatches by the activity; tapping one applies it
                 at once, so there is no dialog between the choice and the
                 preview. -->
            <LinearLayout
                android:id="@+id/config_bg_swatches"
                style="@style/WidgetConfigSwatches" />

            <!-- ── Transparency ──────────────────────────── -->
            <LinearLayout style="@style/WidgetConfigRow">

                <TextView
                    style="@style/WidgetConfigRowLabel"
                    android:text="@string/widget_config_transparency" />

                <TextView
                    android:id="@+id/config_transparency_value"
                    style="@style/WidgetConfigRowValue" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/config_transparency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <!-- ── Text colour ───────────────────────────── -->
            <TextView
                style="@style/WidgetConfigSectionLabel"
                android:text="@string/widget_config_text_color" />

            <!-- Filled with swatches by the activity; tapping one applies it
                 at once, so there is no dialog between the choice and the
                 preview. -->
            <LinearLayout
                android:id="@+id/config_text_swatches"
                style="@style/WidgetConfigSwatches" />

            <!-- ── Prayer card colour ───────────────────────────── -->
            <TextView
                style="@style/WidgetConfigSectionLabel"
                android:text="@string/widget_config_accent" />

            <!-- Filled with swatches by the activity; tapping one applies it
                 at once, so there is no dialog between the choice and the
                 preview. -->
            <LinearLayout
                android:id="@+id/config_accent_swatches"
                style="@style/WidgetConfigSwatches" />

            <!-- ── Font size ─────────────────────────────── -->
            <LinearLayout style="@style/WidgetConfigRow">

                <TextView
                    style="@style/WidgetConfigRowLabel"
                    android:text="@string/widget_config_font_size" />

                <TextView
                    android:id="@+id/config_font_value"
                    style="@style/WidgetConfigRowValue" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/config_font"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ── Time format ───────────────────────────────
                 Global rather than per widget, like the rest of the app's
                 clock: two widgets showing the same timetable in different
                 clocks would read as a bug. Saved with the rest. -->
            <LinearLayout style="@style/WidgetConfigRow">

                <TextView
                    style="@style/WidgetConfigRowLabel"
                    android:text="@string/widget_config_time_format" />

                <RadioGroup
                    android:id="@+id/config_time_format"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/config_time_12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_config_time_12" />

                    <RadioButton
                        android:id="@+id/config_time_24"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/widget_config_time_24" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:paddingTop="20dp">

                <Button
                    android:id="@+id/config_reset"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_config_reset" />

                <Button
                    android:id="@+id/config_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/widget_config_save" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
