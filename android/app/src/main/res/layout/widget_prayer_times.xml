<?xml version="1.0" encoding="utf-8"?>
<!--
  Day layout for the prayer-times widget: a 4x1 strip, dark text on a light
  background. A date column on the left, and on the right a StackView deck of
  one card per visible time (see widget_prayer_card.xml).

  Every view id here must also exist in layout-night/widget_prayer_times.xml —
  the provider sets views by id and a mismatch crashes whichever configuration
  is inflated.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_prayer_background_light"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_date_column"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!--
          Shown instead of the deck until a location has been stored. It lives
          in the date column rather than across the strip so that hiding the
          deck leaves no empty gap.
        -->
        <TextView
            android:id="@+id/widget_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/prayer_widget_prompt"
            android:textColor="@android:color/black"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!--
      The only swipeable primitive RemoteViews offers. The launcher drives the
      gesture itself and pulls each card from PrayerDeckService.
    -->
    <StackView
        android:id="@+id/widget_deck"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:loopViews="true" />

</LinearLayout>
