# Rafeeq — environment variables (copy what you need into .env.local /
# .env.production; never commit real values there). CRA inlines every
# REACT_APP_* value into the app bundle, so only public values belong here.

# Token broker (Cloudflare Worker) — speech engines and Quran content tokens.
REACT_APP_TOKEN_BROKER_URL=

# Quran Foundation Content API: the client id goes out as the x-client-id
# header on every content request. Set the base only to point elsewhere —
# left unset it defaults to the line below (an empty value would not).
REACT_APP_QF_CLIENT_ID=
# REACT_APP_CONTENT_API_BASE=https://apis.quran.foundation/content/api/v4

# For `npm start` only: put the dev broker's URL in .env.development.local
# (CRA reads that file for the dev server, never for production builds):
#   REACT_APP_TOKEN_BROKER_URL=https://rafeeq-token-broker-dev.<account>.workers.dev

# Rafeeq Pro (RevenueCat public SDK keys — public by design). A Test Store
# key (test_…) works only in debug builds; release builds refuse it, since
# the SDK crashes any release build carrying one. Use goog_/appl_ for release.
REACT_APP_REVENUECAT_ANDROID_KEY=
REACT_APP_REVENUECAT_IOS_KEY=

# Rafeeq Pro paywall switch: "on" shows the PRO badge and gates recite for
# non-subscribers. Leave off until store purchases work; turn on for the
# store release, then set REQUIRE_PRO="true" on the broker. Has no effect
# while REACT_APP_ACCOUNTS is off or the Supabase URL/key below are unset.
REACT_APP_PRO_GATE=off

# Accounts (sign-in): "on" enables sign-in; Pro lives on the account. Leave
# off until the Supabase project and OAuth clients are set up.
REACT_APP_ACCOUNTS=off

# Supabase project URL and publishable (anon) key — public by design.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth web client id, used for native Google sign-in.
REACT_APP_GOOGLE_WEB_CLIENT_ID=

# Sign in with Apple is always on for iOS; "on" also offers it on Android.
REACT_APP_APPLE_SIGNIN=off
